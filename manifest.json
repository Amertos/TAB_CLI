{
  "manifest_version": 3,
  "name": "TabCli",
  "version": "2.0",
  "description": "Grouping and managing tabs in a more efficient way.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.ico",
      "48": "icons/icon.ico",
      "128": "icons/icon.ico"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}